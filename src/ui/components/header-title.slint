import { Theme } from "../theme.slint";

export component HeaderTitle inherits Rectangle {
    in property <string> label;
    in property <length> unit;

    Text {
        color: Theme.text;
        font-size: root.unit * 0.65;
        text: root.label;
        x: root.unit * 0.6;
        y: root.unit * 0.3;
    }
}
