import { Theme } from "../theme.slint";

export component HeaderDetails inherits Rectangle {
    in property <string> clock-date;
    in property <string> clock-time;
    in property <length> unit;

    Text {
        color: Theme.text;
        font-size: root.unit * 1.125;
        horizontal-alignment: right;
        text: root.clock-time;
        width: 6 * root.unit;
        x: root.width - 0.6 * root.unit - self.width;
        y: root.unit * 0.3;
    }

    Text {
        color: Theme.text.with-alpha(0.6);
        font-size: root.unit * 0.18;
        horizontal-alignment: right;
        text: root.clock-date;
        width: 6 * root.unit;
        x: root.width - 0.6 * root.unit - self.width;
        y: root.unit * 1.6;
    }
}
