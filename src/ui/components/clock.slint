import { Theme } from "../theme.slint";

export global ClockState {
    in property <string> date;
    in property <string> time;
}

export global ClockSettings {
    in property <float> date_size;
    in property <float> gap;
    in property <float> time_size;
    in property <string> float;

    in property <float> bottom;
    in property <float> left;
    in property <float> right;
    in property <float> top;

    in property <float> padding_bottom;
    in property <float> padding_left;
    in property <float> padding_right;
    in property <float> padding_top;
}

export component Clock inherits Rectangle {
    in property <float> date_size;
    in property <float> gap;
    in property <float> time_size;
    in property <string> float;

    property <length> em: Theme.font_size;

    property <length> date_font_size: root.em * root.date_size;
    property <length> gap_size: root.gap * root.em;
    property <length> time_font_size: root.em * root.time_size;

    property <length> padding_bottom_size: ClockSettings.padding_bottom * root.em;
    property <length> padding_left_size: ClockSettings.padding_left * root.em;
    property <length> padding_right_size: ClockSettings.padding_right * root.em;
    property <length> padding_top_size: ClockSettings.padding_top * root.em;

    out property <length> content_height: root.time_font_size + root.gap_size + root.date_font_size
        + root.padding_top_size + root.padding_bottom_size;
    out property <length> content_width: Math.max(time_text.preferred-width, date_text.preferred-width)
        + root.padding_left_size + root.padding_right_size;

    property <length> clock_height: ClockSettings.top >= 0 && ClockSettings.bottom >= 0
        ? root.height * (100 - ClockSettings.top - ClockSettings.bottom) / 100
        : root.content_height;
    property <length> clock_width: ClockSettings.left >= 0 && ClockSettings.right >= 0
        ? root.width * (100 - ClockSettings.left - ClockSettings.right) / 100
        : root.content_width;

    box := Rectangle {
        background: transparent;
        clip: true;

        height: root.clock_height;
        width: root.clock_width;

        x: ClockSettings.left >= 0
            ? root.width * ClockSettings.left / 100
            : ClockSettings.right >= 0
            ? root.width * (100 - ClockSettings.right) / 100 - self.width
            : 0px;
        y: ClockSettings.top >= 0
            ? root.height * ClockSettings.top / 100
            : ClockSettings.bottom >= 0
            ? root.height * (100 - ClockSettings.bottom) / 100 - self.height
            : 0px;

        time_text := Text {
            color: Theme.foreground;
            font-family: Theme.font_family;
            font-size: root.time_font_size;
            text: ClockState.time;

            horizontal-alignment: root.float == "left" ? left : root.float == "right" ? right : center;
            vertical-alignment: center;

            height: root.time_font_size;
            width: parent.width - root.padding_left_size - root.padding_right_size;

            x: root.padding_left_size;
            y: root.padding_top_size;
        }

        date_text := Text {
            color: Theme.foreground.with-alpha(0.6);
            font-family: Theme.font_family;
            font-size: root.date_font_size;
            text: ClockState.date;

            horizontal-alignment: root.float == "left" ? left : root.float == "right" ? right : center;
            vertical-alignment: center;

            height: root.date_font_size;
            width: parent.width - root.padding_left_size - root.padding_right_size;

            x: root.padding_left_size;
            y: root.padding_top_size + root.time_font_size + root.gap_size;
        }
    }
}
