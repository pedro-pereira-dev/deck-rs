import { Theme } from "../theme.slint";
import { XmbItem } from "xmb-item.slint";

export struct Cell {
    glyph: string,
    index: int,
    label: string,
}

export component XmbColumn inherits Rectangle {
    in property <[Cell]> cells;
    in property <int> selected-index;
    in property <length> viewport-height;
    in property <length> viewport-width;
    in property <float> item-height-percent: 3.0;
    in property <float> item-selected-height-percent: 4.5;
    in property <float> vertical-offset-percent: 0.0;
    in property <float> selected-y-percent: 43.0;
    in property <float> positive-near-step-percent: 7.5;
    in property <float> positive-far-gap-percent: 2.5;
    in property <float> positive-far-step-percent: 5.0;
    in property <float> negative-near-step-percent: 20.0;
    in property <float> negative-far-top-percent: 23.0;
    in property <float> negative-far-step-percent: 5.0;
    in property <float> viewport-top-percent: 33.0;
    in property <float> item-width-percent: 25.3125;
    in property <float> item-font-percent: 1.5;
    in property <float> item-selected-font-percent: 2.25;
    in property <float> item-glyph-font-percent: 2.1;
    in property <float> item-selected-glyph-font-percent: 3.15;
    in property <float> item-glyph-width-percent: 5.625;
    in property <float> item-glyph-offset-percent: -2.8125;
    in property <float> item-label-offset-percent: 2.8125;
    in property <float> selection-line-height-percent: 0.15;
    in property <float> selection-line-offset-percent: 2.61;
    callback pick(int);

    pure function row-y(offset: float) -> length {
        if abs(offset) < 1 && offset > 0 {
            return root.selected-y-percent * root.viewport-height / 100
                + offset * root.positive-near-step-percent * root.viewport-height / 100;
        }
        if offset > 0 {
            return (root.selected-y-percent + root.positive-far-gap-percent
                + offset * root.positive-far-step-percent) * root.viewport-height / 100;
        }
        if offset > -1 {
            return (root.selected-y-percent + offset * root.negative-near-step-percent)
                * root.viewport-height / 100;
        }
        return (root.negative-far-top-percent + (offset + 1) * root.negative-far-step-percent)
            * root.viewport-height / 100;
    }

    clip: true;

    for cell in root.cells: slot := Rectangle {
        property <float> offset: cell.index - root.selected-index;
        property <bool> selected: cell.index == root.selected-index;
        property <length> size: root.viewport-height
            * (root.item-height-percent
                + (root.item-selected-height-percent - root.item-height-percent)
                    * max(1 - abs(offset), 0)) / 100;

        height: slot.size;
        width: root.viewport-width * root.item-width-percent / 100;
        x: 0px;
        y: root.row-y(slot.offset) - slot.height / 2
            + root.vertical-offset-percent * root.viewport-height / 100
            - root.viewport-top-percent * root.viewport-height / 100;
        animate y { duration: Theme.animation; easing: ease-out; }

        XmbItem {
            font-percent: root.item-font-percent;
            glyph: cell.glyph;
            glyph-font-percent: root.item-glyph-font-percent;
            selected-glyph-font-percent: root.item-selected-glyph-font-percent;
            glyph-offset-percent: root.item-glyph-offset-percent;
            glyph-width-percent: root.item-glyph-width-percent;
            label: cell.label;
            label-offset-percent: root.item-label-offset-percent;
            row-height: slot.height;
            row-width-percent: root.item-width-percent;
            selected: slot.selected;
            selected-font-percent: root.item-selected-font-percent;
            selection-line-height-percent: root.selection-line-height-percent;
            selection-line-offset-percent: root.selection-line-offset-percent;
            viewport-height: root.viewport-height;
            viewport-width: root.viewport-width;
            width: parent.width;
        }

        TouchArea {
            height: parent.height;
            width: parent.width;
            clicked => { root.pick(cell.index); }
        }
    }
}
