import { Theme } from "../theme.slint";
import { XmbCategory } from "xmb-category.slint";
import { Cell, XmbColumn } from "xmb-column.slint";

export struct Category {
    glyph: string,
}

export { Cell } from "xmb-column.slint";

export component Xmb inherits Rectangle {
    in property <[Category]> categories;
    in property <[Cell]> cells;
    in property <string> error-message;
    in property <int> selected-category;
    in property <int> selected-item;
    in property <float> category-center-percent: 50.0;
    in property <float> category-center-y-percent: 33.0;
    in property <float> category-gap-percent: 7.875;
    in property <float> category-icon-height-percent: 14.0;
    in property <float> category-icon-percent: 5.0;
    in property <float> category-icon-width-percent: 7.875;
    in property <float> category-selected-icon-percent: 6.0;
    in property <float> error-bottom-percent: 5.0;
    in property <float> error-font-percent: 1.5;
    in property <float> error-horizontal-padding-percent: 3.375;
    in property <float> item-column-offset-percent: 5.625;
    in property <float> item-column-width-percent: 25.3125;
    in property <float> item-font-percent: 1.5;
    in property <float> item-glyph-offset-percent: -2.8125;
    in property <float> item-glyph-percent: 2.1;
    in property <float> item-glyph-width-percent: 5.625;
    in property <float> item-height-percent: 3.0;
    in property <float> item-label-offset-percent: 2.8125;
    in property <float> item-selected-font-percent: 2.25;
    in property <float> item-selected-glyph-percent: 3.15;
    in property <float> item-selected-height-percent: 4.5;
    in property <float> item-selected-y-percent: 43.0;
    in property <float> item-positive-near-step-percent: 7.5;
    in property <float> item-positive-far-gap-percent: 2.5;
    in property <float> item-positive-far-step-percent: 5.0;
    in property <float> item-negative-near-step-percent: 20.0;
    in property <float> item-negative-far-top-percent: 23.0;
    in property <float> item-negative-far-step-percent: 5.0;
    in property <float> selection-line-percent: 0.15;
    in property <float> selection-line-offset-percent: 2.61;
    in property <float> vertical-offset-percent: 0.0;
    in property <float> viewport-top-percent: 33.0;
    in property <string> key_back: "Escape";
    in property <string> key_down: "DownArrow";
    in property <string> key_left: "LeftArrow";
    in property <string> key_menu: "Home";
    in property <string> key_right: "RightArrow";
    in property <string> key_select: "Return";
    in property <string> key_up: "UpArrow";
    callback focus-category(int);
    callback navigate(string);
    callback pick-item(int);
    callback scroll-items(float);
    callback select();

    property <color> subdued: Theme.text.with-alpha(0.6);
    property <length> horizontal-unit: root.width / 100;
    property <length> vertical-unit: root.height / 100;

    background: Theme.background;
    forward-focus: input-focus;

    if Theme.has-background-image: Image {
        height: 100%;
        image-fit: cover;
        source: Theme.background-image;
        width: 100%;
    }

    TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                root.navigate("back");
            }
        }
        scroll-event(event) => {
            if event.delta-y != 0 {
                root.scroll-items(event.delta-y / 1px);
                return accept;
            }
            reject
        }
    }

    for category[index] in root.categories: category-view := XmbCategory {
        glyph: category.glyph;
        icon-font-percent: root.category-icon-percent;
        icon-height-percent: root.category-icon-height-percent;
        icon-width-percent: root.category-icon-width-percent;
        selected: index == root.selected-category;
        selected-icon-font-percent: root.category-selected-icon-percent;
        text-color: Theme.text;
        viewport-height: root.height;
        viewport-width: root.width;
        x: root.width * root.category-center-percent / 100
            - self.width / 2 + (index - root.selected-category)
                * root.category-gap-percent * root.horizontal-unit;
        y: root.category-center-y-percent * root.vertical-unit - self.height / 2;
        animate x { duration: Theme.animation; easing: ease-out; }
        opacity: 1;
        TouchArea {
            clicked => { root.focus-category(index); }
        }
    }

    item-viewport := Rectangle {
        clip: true;
        height: max(0px, root.height - root.viewport-top-percent * root.vertical-unit);
        width: root.width;
        x: 0px;
        y: root.viewport-top-percent * root.vertical-unit;

        XmbColumn {
            cells: root.cells;
            height: parent.height;
            item-font-percent: root.item-font-percent;
            item-glyph-font-percent: root.item-glyph-percent;
            item-glyph-offset-percent: root.item-glyph-offset-percent;
            item-glyph-width-percent: root.item-glyph-width-percent;
            item-height-percent: root.item-height-percent;
            item-label-offset-percent: root.item-label-offset-percent;
            item-selected-font-percent: root.item-selected-font-percent;
            item-selected-glyph-font-percent: root.item-selected-glyph-percent;
            item-selected-height-percent: root.item-selected-height-percent;
            item-width-percent: root.item-column-width-percent;
            negative-far-step-percent: root.item-negative-far-step-percent;
            negative-far-top-percent: root.item-negative-far-top-percent;
            negative-near-step-percent: root.item-negative-near-step-percent;
            positive-far-gap-percent: root.item-positive-far-gap-percent;
            positive-far-step-percent: root.item-positive-far-step-percent;
            positive-near-step-percent: root.item-positive-near-step-percent;
            selected-index: root.selected-item;
            selected-y-percent: root.item-selected-y-percent;
            selection-line-height-percent: root.selection-line-percent;
            selection-line-offset-percent: root.selection-line-offset-percent;
            vertical-offset-percent: root.vertical-offset-percent;
            viewport-height: root.height;
            viewport-top-percent: root.viewport-top-percent;
            viewport-width: root.width;
            width: parent.width;
            x: root.width * root.category-center-percent / 100
                - root.width * root.item-column-offset-percent / 100;
            pick(index) => { root.pick-item(index); }
        }
    }

    if root.error-message != "": Text {
        color: root.subdued;
        font-size: root.error-font-percent * root.vertical-unit;
        text: root.error-message;
        width: root.width - 2 * root.error-horizontal-padding-percent * root.horizontal-unit;
        x: root.error-horizontal-padding-percent * root.horizontal-unit;
        y: root.height - root.error-bottom-percent * root.vertical-unit;
    }

    input-focus := FocusScope {
        key-pressed(event) => {
            if event.text == root.key_left { root.navigate("left"); }
            else if event.text == root.key_right { root.navigate("right"); }
            else if event.text == root.key_up { root.navigate("up"); }
            else if event.text == root.key_down { root.navigate("down"); }
            else if event.text == root.key_select || event.text == " " { root.select(); }
            else if event.text == root.key_back { root.navigate("back"); }
            else if event.text == root.key_menu { root.navigate("menu"); }
            accept
        }
    }

    init => { input-focus.focus(); }
}
