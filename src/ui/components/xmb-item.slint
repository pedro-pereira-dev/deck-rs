import { Theme } from "../theme.slint";

export component XmbItem inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> selected;
    in property <length> row-height;
    in property <length> viewport-height;
    in property <length> viewport-width;
    in property <float> font-percent: 1.5;
    in property <float> selected-font-percent: 2.25;
    in property <float> glyph-font-percent: 2.1;
    in property <float> selected-glyph-font-percent: 3.15;
    in property <float> glyph-width-percent: 5.625;
    in property <float> glyph-offset-percent: -2.8125;
    in property <float> label-offset-percent: 2.8125;
    in property <float> selection-line-height-percent: 0.15;
    in property <float> selection-line-offset-percent: 2.61;
    in property <float> row-width-percent: 25.3125;
    in property <color> text-color: Theme.text;
    in property <float> tint-opacity: 0.15;

    height: root.row-height;
    width: root.viewport-width * root.row-width-percent / 100;

    Text {
        color: root.selected ? root.text-color : root.text-color.with-alpha(root.tint-opacity);
        font-family: Theme.font-family;
        font-size: root.viewport-height
            * (root.selected ? root.selected-glyph-font-percent : root.glyph-font-percent) / 100;
        horizontal-alignment: center;
        text: root.glyph;
        vertical-alignment: center;
        height: parent.height;
        width: root.viewport-width * root.glyph-width-percent / 100;
        x: root.viewport-width * root.glyph-offset-percent / 100;
    }

    label-text := Text {
        color: root.selected ? root.text-color : root.text-color.with-alpha(root.tint-opacity);
        font-size: root.viewport-height
            * (root.selected ? root.selected-font-percent : root.font-percent) / 100;
        overflow: elide;
        text: root.label;
        vertical-alignment: top;
        height: parent.height;
        width: parent.width - root.viewport-width * root.label-offset-percent / 100;
        x: root.viewport-width * root.label-offset-percent / 100;
    }

    if root.selected: Rectangle {
        background: root.text-color;
        height: root.viewport-height * root.selection-line-height-percent / 100;
        width: min(label-text.preferred-width, label-text.width);
        x: label-text.x;
        y: root.viewport-height * root.selection-line-offset-percent / 100;
    }
}
