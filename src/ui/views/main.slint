import { Theme } from "../theme.slint";
import { Clock, ClockSettings } from "../components/clock.slint";

export component MainView inherits Rectangle {
    background: Theme.background;

    Clock {
        date_size: ClockSettings.date_size;
        float: ClockSettings.float;
        gap: ClockSettings.gap;
        time_size: ClockSettings.time_size;

        height: root.height;
        width: root.width;

        x: 0px;
        y: 0px;
    }
}
