export global Theme {
    in property <color> accent: #8ab4f8;
    in property <color> background: #080b12;
    in property <color> muted: #9198a8;
    in property <color> panel: #171d29;
    in property <color> selected: #252f40;
    in property <color> text: #f3f5f8;
    in property <string> font-family: "Symbols Nerd Font Mono";
    in property <length> category-gap: 48px;
    in property <length> item-gap: 18px;
    in property <length> item-size: 30px;
}
